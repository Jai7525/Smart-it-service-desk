# ==============================================================================
# Supabase & Application Environment Configuration
# ==============================================================================

# Project Name
PROJECT_NAME="Smart IT Service Desk & Workflow Automation Platform"
ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# Supabase Database (PostgreSQL)
# ------------------------------------------------------------------------------
# In your Supabase Dashboard:
# 1. Go to Project Settings -> Database -> Connection string -> URI
# 2. Replace [YOUR-PASSWORD] with your actual database password
# Example format:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For session pooler / transaction pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=sqlite:///./smart_ticket.db

# ------------------------------------------------------------------------------
# Supabase API & Auth
# ------------------------------------------------------------------------------
# In your Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# In Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret:
SUPABASE_JWT_SECRET=supersecret-dev-key-change-in-production

# ------------------------------------------------------------------------------
# SLA Configurations (in hours)
# ------------------------------------------------------------------------------
SLA_CRITICAL_RESPONSE_HOURS=0.5
SLA_CRITICAL_RESOLUTION_HOURS=2.0
SLA_HIGH_RESPONSE_HOURS=1.0
SLA_HIGH_RESOLUTION_HOURS=4.0
SLA_MEDIUM_RESPONSE_HOURS=4.0
SLA_MEDIUM_RESOLUTION_HOURS=24.0
SLA_LOW_RESPONSE_HOURS=8.0
SLA_LOW_RESOLUTION_HOURS=48.0

# ------------------------------------------------------------------------------
# Similar Incident Detection Thresholds (PRD 5.4, SRS FR-10)
# ------------------------------------------------------------------------------
SIMILARITY_TIME_WINDOW_MINUTES=10
SIMILARITY_THRESHOLD_COUNT=5

# ------------------------------------------------------------------------------
# Google Gemini Generative AI Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash


